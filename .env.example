# OpenClaw / TailwindVault Environment Variables
# Copy to .env and fill in your values

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (or group ID for multi-user rooms)
TELEGRAM_CHAT_ID=

# GitHub personal access token (needs repo scope)
GITHUB_TOKEN=

# GitHub repository owner (username or org)
GITHUB_OWNER=

# GitHub repository name
GITHUB_REPO=

# OpenClaw workspace name (usually same as repo)
OPENCLAW_REPO_NAME=tailwindvault
